%.pptx: %.md scripts/fit_pptx.py
	pandoc $< -o $@ --slide-level=2 --resource-path=$(dir $<)
	python3 scripts/fit_pptx.py $@

# Course03's interactive companions: the same two lectures as Slidev decks,
# where the figures are recomputed in the browser as the sliders move. One npm
# project holds both: they share style.css, the components and the lib, and
# differ only in their slides*.md.
# Needs node and npm; the first run installs into Course03/slidev/node_modules.
C03_SLIDEV_SHARED := Course03/slidev/style.css \
                     $(wildcard Course03/slidev/components/*.vue) \
                     $(wildcard Course03/slidev/layouts/*.vue) \
                     $(wildcard Course03/slidev/setup/*.ts) \
                     $(wildcard Course03/slidev/lib/*.ts)
C03_SLIDEV_SRC := Course03/slidev/slides.md $(C03_SLIDEV_SHARED)

interactive: Course03/slidev/node_modules
	cd Course03/slidev && npm run dev

interactive-c04: Course04/slidev/node_modules
	cd Course04/slidev && npm run dev

interactive-c05: Course05/slidev/node_modules
	cd Course05/slidev && npm run dev

interactive-c06: Course06/slidev/node_modules
	cd Course06/slidev && npm run dev

interactive-c07: Course07/slidev/node_modules
	cd Course07/slidev && npm run dev

interactive-c08: Course08/slidev/node_modules
	cd Course08/slidev && npm run dev

interactive-build: Course03/interactive.html Course04/interactive.html \
                   Course05/interactive.html Course06/interactive.html \
                   Course07/interactive.html Course08/interactive.html

Course03/slidev/node_modules: Course03/slidev/package.json
	cd Course03/slidev && npm install --no-audit --no-fund
	@touch $@

Course04/slidev/node_modules: Course04/slidev/package.json
	cd Course04/slidev && npm install --no-audit --no-fund
	@touch $@

Course05/slidev/node_modules: Course05/slidev/package.json
	cd Course05/slidev && npm install --no-audit --no-fund
	@touch $@

Course06/slidev/node_modules: Course06/slidev/package.json
	cd Course06/slidev && npm install --no-audit --no-fund
	@touch $@

Course07/slidev/node_modules: Course07/slidev/package.json
	cd Course07/slidev && npm install --no-audit --no-fund
	@touch $@

Course08/slidev/node_modules: Course08/slidev/package.json
	cd Course08/slidev && npm install --no-audit --no-fund
	@touch $@

# The deck ships as ONE committed, self-contained file, because the Pages
# workflow uploads the repository as it stands and never runs a build:
#   Course03/interactive.html  ->  <pages>/Course03/interactive.html
# Everything is inlined, so the same file also opens straight from disk — a
# browser blocks ES modules loaded next to a file:// page, which is why a
# split build opens blank when the file is double-clicked.
Course03/interactive.html: $(C03_SLIDEV_SRC) Course03/slidev/vite.config.ts \
                           Course03/slidev/node_modules
	cd Course03/slidev && npm run build
	cp Course03/slidev/dist/index.html $@

# Course04's companion is its own npm project: nothing is shared with
# Course03, so either deck can be rebuilt without touching the other.
C04_SLIDEV_SRC := Course04/slidev/slides.md Course04/slidev/style.css \
                  $(wildcard Course04/slidev/components/*.vue) \
                  $(wildcard Course04/slidev/layouts/*.vue) \
                  $(wildcard Course04/slidev/setup/*.ts) \
                  $(wildcard Course04/slidev/lib/*.ts) \
                  $(wildcard Course04/data/*.json)

Course04/interactive.html: $(C04_SLIDEV_SRC) Course04/slidev/vite.config.ts \
                           Course04/slidev/node_modules
	cd Course04/slidev && npm run build
	cp Course04/slidev/dist/index.html $@

# Course05's companion, also its own npm project. Its data (the faces, the
# posts, the toy matrices) is written by scripts/make_data_c05.py.
C05_SLIDEV_SRC := Course05/slidev/slides.md Course05/slidev/style.css \
                  $(wildcard Course05/slidev/components/*.vue) \
                  $(wildcard Course05/slidev/layouts/*.vue) \
                  $(wildcard Course05/slidev/setup/*.ts) \
                  $(wildcard Course05/slidev/lib/*.ts) \
                  $(wildcard Course05/data/*.json)

Course05/interactive.html: $(C05_SLIDEV_SRC) Course05/slidev/vite.config.ts \
                           Course05/slidev/node_modules
	cd Course05/slidev && npm run build
	cp Course05/slidev/dist/index.html $@

# Course06's companion, its own npm project too. It needs no data file: the
# animal lengths and Fisher's iris are written into lib/, and every other
# sample is drawn in the browser from a fixed seed.
C06_SLIDEV_SRC := Course06/slidev/slides.md Course06/slidev/style.css \
                  $(wildcard Course06/slidev/components/*.vue) \
                  $(wildcard Course06/slidev/layouts/*.vue) \
                  $(wildcard Course06/slidev/setup/*.ts) \
                  $(wildcard Course06/slidev/lib/*.ts)

Course06/interactive.html: $(C06_SLIDEV_SRC) Course06/slidev/vite.config.ts \
                           Course06/slidev/node_modules
	cd Course06/slidev && npm run build
	cp Course06/slidev/dist/index.html $@

# Course08's companion, its own npm project. No data file: Bishop's ten
# points are written into lib/c08.ts, every other sample is drawn in the
# browser from a fixed seed.
C08_SLIDEV_SRC := Course08/slidev/slides.md Course08/slidev/style.css \
                  $(wildcard Course08/slidev/components/*.vue) \
                  $(wildcard Course08/slidev/layouts/*.vue) \
                  $(wildcard Course08/slidev/setup/*.ts) \
                  $(wildcard Course08/slidev/lib/*.ts)

Course08/interactive.html: $(C08_SLIDEV_SRC) Course08/slidev/vite.config.ts \
                           Course08/slidev/node_modules
	cd Course08/slidev && npm run build
	cp Course08/slidev/dist/index.html $@

clean-interactive:
	rm -rf Course03/slidev/dist Course04/slidev/dist Course05/slidev/dist \
	       Course06/slidev/dist Course07/slidev/dist Course08/slidev/dist \
	       Course03/interactive.html Course04/interactive.html \
	       Course05/interactive.html Course06/interactive.html \
	       Course07/interactive.html Course08/interactive.html

clean-slides:
	rm -f $(SLIDE_TARGETS)

clean-figures:
	rm -f $(C01_FIGURES) $(DS_FIGURES) $(C02_FIGURES) $(C03_FIGURES) \
	        $(C04_FIGURES) $(C05_FIGURES) $(C06_FIGURES) $(C07_FIGURES) \
	        $(C08_FIGURES)
